# Local API credentials (never commit real keys)
.pi/config/api-keys.json
.pi/config/*.local.json

# Runtime state (never a source of truth)
.pi/agent-sessions/
.swarm/

# Probe outputs, baselines, recordings
artifacts/
.tape/*-sessions/

# Build output and dependencies
**/dist/
**/node_modules/

# Pi project-scope package installs (pi install -l)
.pi/git/
.pi/npm/
