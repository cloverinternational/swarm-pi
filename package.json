{
  "name": "@pi-swarm/integration",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/trebol-toggle/index.ts",
      "extensions/pi-tmux-resurrection/index.ts",
      "extensions/cache-telemetry/index.ts",
      "extensions/swarm-update/index.ts",
      "extensions/bootstrap/index.ts",
      "extensions/hooks/index.ts",
      "extensions/mcp-fallback/index.ts",
      "extensions/swarm-transport-parity/index.ts",
      "extensions/autogenskills/index.ts",
      "extensions/mermaid-response/index.ts",
      "extensions/prompt-context-configure/index.ts",
      "extensions/swarm-plan-mode/index.ts",
      "extensions/swarm-prompt/index.ts",
      "extensions/swarm-auto/index.ts",
      "extensions/swarm-skills/index.ts",
      "extensions/swarm-thinking/index.ts",
      "extensions/system-inspector/index.ts",
      "extensions/system-prompts/index.ts",
      "extensions/swarm-context/index.ts",
      "extensions/mandatory-compaction/index.ts",
      "extensions/swarm-disk-hooks/index.ts",
      "extensions/project-init/index.ts",
      "extensions/annoyed/index.ts",
      "extensions/control-task-tools/index.ts",
      "extensions/history-search/index.ts",
      "extensions/ask-user/index.ts",
      "extensions/research-tools/index.ts",
      "extensions/swarm-monitor/index.ts",
      "extensions/swarm-websearch/index.ts",
      "extensions/swarm-goal/index.ts",
      "extensions/swarm-agent-tools/index.ts",
      "extensions/swarm-background-bash/index.ts",
      "extensions/swarm-bash/index.ts",
      "extensions/swarm-fs-tools/index.ts",
      "extensions/swarm-history-vault-tools/index.ts",
      "extensions/taskmanage/index.ts",
      "extensions/vault/index.ts",
      "extensions/memory-history/index.ts",
      "extensions/task-candidate-capture/index.ts",
      "extensions/knowledge-enrichment/index.ts",
      "extensions/candidate-memory-review/index.ts",
      "extensions/jev-knowledge-audit/index.ts",
      "extensions/memory-maintenance/index.ts",
      "extensions/swarm-conversation-metadata/index.ts",
      "extensions/control-panel/index.ts",
      "extensions/supervisor/index.ts",
      "extensions/conversation-metrics/index.ts",
      "extensions/clover-startup/index.ts",
      "extensions/swarm-themes/index.ts",
      "extensions/swarm-tools-status/index.ts",
      "extensions/swarm-btw/index.ts",
      "extensions/swarm-image-paste/index.ts",
      "extensions/green-chat-input/index.ts"
    ],
    "themes": [
      ".pi/themes"
    ]
  },
  "scripts": {
    "prepare": "npm run build:runtime",
    "build:runtime": "npm run build -w @pi-swarm/runtime-contracts && npm run build -w @pi-swarm/core && npm run build -w @pi-swarm/bootstrap",
    "build": "npm run build -w @pi-swarm/contract && npm run build -w @pi-swarm/core && npm run build -w @pi-swarm/runtime-contracts && npm run build -w @pi-swarm/bootstrap && npm run build -w @pi-swarm/prompt && npm run build -w @pi-swarm/skills && npm run build -w @pi-swarm/autogenskills && npm run build -w @pi-swarm/policy && npm run build -w @pi-swarm/schedule && npm run build -w @pi-swarm/agents && npm run build -w @pi-swarm/mcp && npm run build -w @pi-swarm/taskmanage",
    "test": "vitest run",
    "test:integration": "node ./tools/integration/run-postgres-integration.mjs",
    "doctor": "node tools/install/doctor.mjs",
    "dogfood": "npm run build && npm test",
    "check:install": "node tools/install/check-load.mjs",
    "check:extension-parity": "node tools/install/extension-inventory.mjs --compare docs/parity/extension-surface-before.json --surface-only",
    "test:ask-user": "node --experimental-strip-types --test extensions/ask-user/tests/*.test.ts"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "dependencies": {
    "@types/node": "^22.0.0",
    "mermaid": "^11.12.3",
    "re2-wasm": "1.0.2",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@types/pg": "^8.23.1",
    "typebox": "^1.3.36",
    "vitest": "^3.2.0"
  }
}
