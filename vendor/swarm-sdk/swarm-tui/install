#!/bin/bash
# Install script for SwarmOS TUI
# Builds and installs the binary globally, even if currently running

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
BINARY_NAME="swarmos"
INSTALL_DIR="/usr/local/bin"
BUILD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMP_BINARY="/tmp/${BINARY_NAME}-install-$$"

# Helper functions
info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

error() {
    echo -e "${RED}✗${NC} $1"
}

# Print header
echo ""
echo "=========================================="
echo "  SwarmOS TUI Installation"
echo "=========================================="
echo ""

# Check if we're in the right directory
if [ ! -f "cmd/swarmos/main.go" ]; then
    error "Error: Not in the TUI directory"
    error "Please run this script from the TUI root directory"
    exit 1
fi
success "Found TUI source directory"

# Check if Go is installed
if ! command -v go &> /dev/null; then
    error "Go is not installed"
    error "Please install Go from https://golang.org/dl/"
    exit 1
fi
success "Go is installed: $(go version)"

# Check for running instances
info "Checking for running instances..."
RUNNING_PIDS=$(pgrep -f "^${INSTALL_DIR}/${BINARY_NAME}" || true)
if [ -n "$RUNNING_PIDS" ]; then
    warning "Found running instance(s): PIDs $RUNNING_PIDS"
    info "Will stop them before installing"
else
    success "No running instances found"
fi

# Build the binary
info "Building ${BINARY_NAME}..."
echo ""
if go build -o "$TEMP_BINARY" ./cmd/swarmos/; then
    success "Build successful"
    
    # Show binary info
    SIZE=$(du -h "$TEMP_BINARY" | cut -f1)
    info "Binary size: $SIZE"
else
    error "Build failed"
    exit 1
fi
echo ""

# Stop running instances
if [ -n "$RUNNING_PIDS" ]; then
    info "Stopping running instances..."
    for PID in $RUNNING_PIDS; do
        if kill $PID 2>/dev/null; then
            success "Stopped process $PID"
        else
            warning "Could not stop process $PID (may have already exited)"
        fi
    done
    
    # Wait a moment for processes to fully exit
    sleep 1
    
    # Force kill if still running
    STILL_RUNNING=$(pgrep -f "^${INSTALL_DIR}/${BINARY_NAME}" || true)
    if [ -n "$STILL_RUNNING" ]; then
        warning "Force killing remaining processes..."
        for PID in $STILL_RUNNING; do
            kill -9 $PID 2>/dev/null || true
        done
        sleep 1
    fi
    
    success "All instances stopped"
fi

# Check if we need sudo for installation
NEED_SUDO=false
if [ ! -w "$INSTALL_DIR" ]; then
    NEED_SUDO=true
    warning "Installation requires sudo (writing to $INSTALL_DIR)"
fi

# Install the binary
info "Installing to $INSTALL_DIR/${BINARY_NAME}..."

if [ "$NEED_SUDO" = true ]; then
    # Use sudo to install
    if sudo mv -f "$TEMP_BINARY" "$INSTALL_DIR/${BINARY_NAME}"; then
        sudo chmod +x "$INSTALL_DIR/${BINARY_NAME}"
        success "Installed with sudo"
    else
        error "Installation failed"
        rm -f "$TEMP_BINARY"
        exit 1
    fi
else
    # Direct install
    if mv -f "$TEMP_BINARY" "$INSTALL_DIR/${BINARY_NAME}"; then
        chmod +x "$INSTALL_DIR/${BINARY_NAME}"
        success "Installed"
    else
        error "Installation failed"
        rm -f "$TEMP_BINARY"
        exit 1
    fi
fi

# Verify installation
if [ -x "$INSTALL_DIR/${BINARY_NAME}" ]; then
    success "Installation verified"
    INSTALLED_SIZE=$(du -h "$INSTALL_DIR/${BINARY_NAME}" | cut -f1)
    info "Installed binary: $INSTALL_DIR/${BINARY_NAME} ($INSTALLED_SIZE)"
else
    error "Installation verification failed"
    exit 1
fi

# Check if install dir is in PATH
echo ""
if echo "$PATH" | grep -q "$INSTALL_DIR"; then
    success "$INSTALL_DIR is in your PATH"
else
    warning "$INSTALL_DIR is NOT in your PATH"
    warning "Add this to your ~/.bashrc or ~/.zshrc:"
    echo "    export PATH=\"$INSTALL_DIR:\$PATH\""
fi

# Print completion message
echo ""
echo "=========================================="
echo -e "${GREEN}✓ Installation Complete!${NC}"
echo "=========================================="
echo ""
echo "You can now run:"
echo -e "  ${BLUE}${BINARY_NAME}${NC}"
echo ""
echo "Or with full path:"
echo -e "  ${BLUE}${INSTALL_DIR}/${BINARY_NAME}${NC}"
echo ""

# Optional: Show quick start info
echo "Quick Start:"
echo "  1. Run: ${BINARY_NAME}"
echo "  2. Type: /commands (to see all available commands)"
echo "  3. Try: /feature-dev Add a hello function"
echo ""

# Check for plugins
PLUGIN_DIR="$HOME/.claude/plugins/cache"
if [ -d "$PLUGIN_DIR" ]; then
    PLUGIN_COUNT=$(find "$PLUGIN_DIR" -maxdepth 2 -name "plugin.json" 2>/dev/null | wc -l)
    if [ "$PLUGIN_COUNT" -gt 0 ]; then
        info "Found $PLUGIN_COUNT installed plugin(s)"
        echo "  Use: /commands plugin (to see plugin commands)"
        echo ""
    fi
fi

# Show version if available
if "$INSTALL_DIR/${BINARY_NAME}" --version 2>/dev/null; then
    echo ""
fi

success "Installation complete!"
